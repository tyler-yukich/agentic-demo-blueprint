{
  "name": "agentic-demo-blueprint",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embedded": "tsc -b && vite build --config vite.embedded.config.ts",
    "embedded:check": "node scripts/verify-embedded.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "fixtures:check": "node scripts/generate-fixtures.mjs --check",
    "fixtures:write": "node scripts/generate-fixtures.mjs --write",
    "salesforce:seed:check": "node scripts/generate-salesforce-seed.mjs --check",
    "salesforce:seed:write": "node scripts/generate-salesforce-seed.mjs --write",
    "safety": "node scripts/public-safety.mjs",
    "verify": "npm run fixtures:check && npm run salesforce:seed:check && npm run typecheck && npm test && npm run build && npm run build:embedded && npm run embedded:check && npm run safety"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
